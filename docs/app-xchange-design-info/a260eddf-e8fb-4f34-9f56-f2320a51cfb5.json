                "Body": "=const response = flow.step('update').actionResponse;\nconst request = flow.step('update').actionRequest;\nconst title = 'Company Equipment Status Update Failure Notification';\nlet body = '';\n\nfunction parseArray(key, val) {\n  if (key === null) return;\n  if (val.length === 0) return;\n  // Remove the recursive check — val is already the array here\n  val.forEach((v, i) => {\n    if (v !== null && typeof v !== 'object') {\n      body += `<tr><td><strong>${key} - ${i}</strong></td><td>${v}</td></tr>`;\n    }\n  });\n}\n\nfunction parseObject(value) {\n  if (value === null) return;\n  Object.entries(value).forEach(([key, val]) => {\n    if (Array.isArray(val)) {\n      parseArray(key, val);\n    } else if (val !== null && typeof val === 'object') {\n      parseObject(val);\n    } else {\n      body += `<tr><td><strong>${key}</strong></td><td>${val}</td></tr>`;\n    }\n  });\n}\n\nbody += `<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:collapse;font-family:Arial,sans-serif;font-size:14px;color:#222;\">\n  <tr>\n    <td style=\"padding:12px 0;font-size:18px;font-weight:bold;\">\n      ${title}\n    </td>\n  </tr>\n</table>\n\n  \n<table role=\"presentation\" cellpadding=\"8\" cellspacing=\"0\" border=\"1\" width=\"100%\" style=\"border-collapse:collapse;font-family:Arial,sans-serif;font-size:14px;color:#222;border:1px solid #ccc;\">\n  <tr style=\"background-color:#f5f5f5;font-weight:bold;\">\n    <td colspan=\"2\">Request Details</td>\n  </tr>`;\n\nObject.entries(request).forEach(([key, val]) => {\n  body += `<tr><td><strong>${key}</strong></td><td>${val}</td></tr>`;\n});\n\nbody += `</table>\n\n<br>\n\n<table role=\"presentation\" cellpadding=\"8\" cellspacing=\"0\" border=\"1\" width=\"100%\" style=\"border-collapse:collapse;font-family:Arial,sans-serif;font-size:14px;color:#222;border:1px solid #ccc;\">\n  <tr style=\"background-color:#f5f5f5;font-weight:bold;\">\n    <td colspan=\"2\">Response Details</td>\n  </tr>`;\n\nObject.entries(response.result).forEach(([key, val]) => {\n  if (Array.isArray(val)) {\n    parseArray(key, val);\n  }\n\n  if (val !== null && typeof val === 'object') {\n    parseObject(val);\n  }\n\n  body += `<tr><td><strong>${key}</strong></td><td>${val}</td></tr>`;\n});\n\nbody += '</table>';\n\nreturn body;"
