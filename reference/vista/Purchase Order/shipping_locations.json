{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com/po/v1/object/shipping_locations/cache.json",
  "type": "object",
  "properties": {
    "POCo": {
      "type": "integer",
      "description": ""
    },
    "ShipLoc": {
      "type": "string",
      "maxLength": 10,
      "description": ""
    },
    "Description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30,
      "description": ""
    },
    "Address": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60,
      "description": ""
    },
    "City": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30,
      "description": ""
    },
    "State": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4,
      "description": ""
    },
    "Zip": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 12,
      "description": ""
    },
    "Notes": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "TaxGroup": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "TaxCode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10,
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "Address2": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60,
      "description": ""
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "Country": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2,
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "POCo",
    "ShipLoc",
    "KeyID"
  ]
}