{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com/dm/v2/object/attachments/cache.json",
  "type": "object",
  "properties": {
    "HQCo": {
      "type": "integer",
      "description": ""
    },
    "FormName": {
      "type": "string",
      "maxLength": 30,
      "description": ""
    },
    "KeyField": {
      "type": "string",
      "maxLength": 500,
      "description": ""
    },
    "Description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255,
      "description": ""
    },
    "AddedBy": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128,
      "description": ""
    },
    "AddDate": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "DocName": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512,
      "description": ""
    },
    "AttachmentID": {
      "type": "integer",
      "description": ""
    },
    "TableName": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128,
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "OrigFileName": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512,
      "description": ""
    },
    "DocAttchYN": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "CurrentState": {
      "type": "string",
      "maxLength": 1,
      "description": "(A)ttached, (S)tandalone, (D)eleted"
    },
    "AttachmentTypeID": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "IsEmail": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "HQCo",
    "FormName",
    "KeyField",
    "AttachmentID",
    "DocAttchYN",
    "CurrentState",
    "IsEmail",
    "KeyID"
  ]
}