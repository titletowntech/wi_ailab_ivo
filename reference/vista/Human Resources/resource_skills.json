{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com//v/object/ResourceSkills/cache.json",
  "type": "object",
  "properties": {
    "HRCo": {
      "type": "integer",
      "description": ""
    },
    "HRRef": {
      "type": "integer",
      "description": ""
    },
    "Code": {
      "type": "string",
      "maxLength": 10,
      "description": ""
    },
    "CertDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": ""
    },
    "ExpireDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": ""
    },
    "SkillTester": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 50,
      "description": ""
    },
    "HistSeq": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "Notes": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "Type": {
      "type": "string",
      "maxLength": 1,
      "description": ""
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "HRCo",
    "HRRef",
    "Code",
    "Type",
    "KeyID"
  ]
}