{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com//v/object/resource_scheduling/cache.json",
  "type": "object",
  "properties": {
    "HRCo": {
      "type": "integer",
      "description": ""
    },
    "HRRef": {
      "type": "integer",
      "description": ""
    },
    "Date": {
      "type": "string",
      "description": "Format: YYYY-MM-DD"
    },
    "Description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30,
      "description": ""
    },
    "ScheduleCode": {
      "type": "string",
      "maxLength": 10,
      "description": ""
    },
    "Notes": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "Seq": {
      "type": "integer",
      "description": ""
    },
    "Hours": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,8}(?:.[0-9]{0,2})?$",
      "description": ""
    },
    "Status": {
      "type": "string",
      "maxLength": 1,
      "description": "Options: N-New, A-Approved, D-Denied, C-Canceled"
    },
    "Source": {
      "type": "string",
      "maxLength": 10,
      "description": ""
    },
    "RequesterComment": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255,
      "description": ""
    },
    "ApproverComment": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255,
      "description": ""
    },
    "Approver": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128,
      "description": ""
    },
    "UpdatedBy": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128,
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "HRCo",
    "HRRef",
    "Date",
    "ScheduleCode",
    "KeyID",
    "Seq",
    "Hours",
    "Status",
    "Source"
  ]
}