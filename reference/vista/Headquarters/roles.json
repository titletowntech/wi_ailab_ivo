      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "UsableInPM": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "UsableInSM": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
