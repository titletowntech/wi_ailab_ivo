          "Type": {
            "type": "string",
            "maxLength": 10,
            "description": ""
          },
          "SubType": {
            "type": "string",
            "maxLength": 10,
            "description": ""
          },
          "Limit": {
            "type": "string",
            "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{1,2})?$",
            "description": ""
          },
          "Threshold": {
            "type": "string",
            "pattern": "^[-+]?[0-9]{1,2}(?:.[0-9]{1,4})?$",
            "description": ""
          },
          "Active": {
            "type": "string",
            "enum": [
              "Y",
              "N"
            ],
            "description": ""
          },
          "Notes": {
            "type": [
              "string",
              "null"
            ],
            "description": ""
