{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com/hq/v2/object/unit_of_measures/cache.json",
  "type": "object",
  "properties": {
    "UM": {
      "type": "string",
      "maxLength": 3,
      "description": ""
    },
    "Description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30,
      "description": ""
    },
    "Notes": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "ExcludeFromLookup": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "UM",
    "KeyID",
    "ExcludeFromLookup"
  ]
}