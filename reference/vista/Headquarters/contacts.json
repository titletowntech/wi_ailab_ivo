      "type": [
        "string",
        "null"
      ],
      "maxLength": 60,
      "description": ""
    },
    "Address": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60,
      "description": ""
    },
    "AddressAdditional": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60,
      "description": ""
    },
    "City": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30,
