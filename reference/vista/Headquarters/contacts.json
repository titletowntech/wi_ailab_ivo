    "Title": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30,
      "description": ""
    },
    "Organization": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60,
      "description": ""
    },
    "Phone": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20,
      "description": ""
