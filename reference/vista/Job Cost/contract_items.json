{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com/v/object/jc/2/contract_items/cache.json",
  "type": "object",
  "properties": {
    "JCCo": {
      "type": "integer",
      "description": ""
    },
    "Contract": {
      "type": "string",
      "maxLength": 10,
      "description": ""
    },
    "Item": {
      "type": "string",
      "maxLength": 16,
      "description": ""
    },
    "Description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60,
      "description": ""
    },
    "Department": {
      "type": "string",
      "maxLength": 10,
      "description": ""
    },
    "TaxGroup": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "TaxCode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10,
      "description": ""
    },
    "UM": {
      "type": "string",
      "maxLength": 3,
      "description": ""
    },
    "SIRegion": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 6,
      "description": ""
    },
    "SICode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 16,
      "description": ""
    },
    "RetainPCT": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,2}(?:.[0-9]{0,4})?$",
      "description": ""
    },
    "OrigContractAmt": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": ""
    },
    "OrigContractUnits": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,9}(?:.[0-9]{0,3})?$",
      "description": ""
    },
    "OrigUnitPrice": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,11}(?:.[0-9]{0,5})?$",
      "description": ""
    },
    "ContractAmt": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": ""
    },
    "ContractUnits": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,9}(?:.[0-9]{0,3})?$",
      "description": ""
    },
    "UnitPrice": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,11}(?:.[0-9]{0,5})?$",
      "description": ""
    },
    "BilledAmt": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": ""
    },
    "BilledUnits": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,9}(?:.[0-9]{0,3})?$",
      "description": ""
    },
    "ReceivedAmt": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": ""
    },
    "CurrentRetainAmt": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": ""
    },
    "BillType": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1,
      "description": ""
    },
    "BillGroup": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20,
      "description": ""
    },
    "BillDescription": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60,
      "description": ""
    },
    "BillOriginalUnits": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,9}(?:.[0-9]{0,3})?$",
      "description": ""
    },
    "BillOriginalAmt": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": ""
    },
    "BillCurrentUnits": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,9}(?:.[0-9]{0,3})?$",
      "description": ""
    },
    "BillCurrentAmt": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": ""
    },
    "BillUnitPrice": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,11}(?:.[0-9]{0,5})?$",
      "description": ""
    },
    "Notes": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "InitSubs": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "StartMonth": {
      "type": "string",
      "description": "Format: YYYY-MM-01."
    },
    "MarkUpRate": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,2}(?:.[0-9]{0,6})?$",
      "description": ""
    },
    "ProjNotes": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "ProjPlug": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "InitAsZero": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "JCCo",
    "Contract",
    "Item",
    "KeyID"
  ]
}