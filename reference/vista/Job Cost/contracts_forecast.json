{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com//v/object/contracts_forecast/cache.json",
  "type": "object",
  "properties": {
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "JCCo": {
      "type": "integer",
      "description": ""
    },
    "Contract": {
      "type": "string",
      "maxLength": 10,
      "description": ""
    },
    "ForecastMonth": {
      "type": "string",
      "format": "date",
      "pattern": "^([0-9]{4})-(1[0-2]|0[1-9])-01$",
      "description": "Format: YYYY-MM-01."
    },
    "RevenuePct": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,2}(?:.[0-9]{0,4})?$",
      "description": ""
    },
    "CostPct": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,2}(?:.[0-9]{0,4})?$",
      "description": ""
    },
    "Notes": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "KeyID",
    "JCCo",
    "Contract",
    "ForecastMonth",
    "RevenuePct",
    "CostPct"
  ]
}