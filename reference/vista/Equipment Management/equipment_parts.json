{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com//v/object/EquipmentParts/cache.json",
  "type": "object",
  "properties": {
    "EMCo": {
      "type": "integer",
      "description": ""
    },
    "Equipment": {
      "type": "string",
      "maxLength": 10,
      "description": ""
    },
    "PartNo": {
      "type": "string",
      "maxLength": 30,
      "description": ""
    },
    "Description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60,
      "description": ""
    },
    "MatlGroup": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "HQMatl": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20,
      "description": ""
    },
    "Qty": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[-+]?[0-9]{1,9}(?:.[0-9]{0,3})?$",
      "description": ""
    },
    "UM": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 3,
      "description": ""
    },
    "Notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30,
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "EMCo",
    "Equipment",
    "PartNo",
    "KeyID"
  ]
}