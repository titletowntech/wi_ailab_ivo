    },
    "Rules": {
      "type": "array",
      "description": "",
      "items": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "http://vista.si.ryvit.com//v/object/Rules/cache.json",
        "type": "object",
        "properties": {
          "Sequence": {
            "type": "integer",
            "description": ""
          },
          "EMGroup": {
            "type": [
              "integer",
              "null"
            ],
            "description": ""
          },
          "MoreThanHrs": {
            "type": "string",
            "pattern": "^[-+]?[0-9]{1,8}(?:.[0-9]{0,2})?$",
            "description": ""
          },
          "LessThanHrs": {
            "type": "string",
            "pattern": "^[-+]?[0-9]{1,8}(?:.[0-9]{0,2})?$",
            "description": ""
          },
          "RevCode": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 10,
            "description": ""
          },
          "UniqueAttchID": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 36,
            "maxLength": 36,
            "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
            "description": ""
          },
          "KeyID": {
            "type": "integer",
            "description": ""
