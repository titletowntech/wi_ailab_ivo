{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com//v/object/RevenueCodes/cache.json",
  "type": "object",
  "properties": {
    "EMGroup": {
      "type": "integer",
      "description": ""
    },
    "RevCode": {
      "type": "string",
      "maxLength": 10,
      "description": ""
    },
    "Description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30,
      "description": ""
    },
    "Basis": {
      "type": "string",
      "maxLength": 1,
      "description": ""
    },
    "WorkUM": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 3,
      "description": ""
    },
    "TimeUM": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 3,
      "description": ""
    },
    "HrsPerTimeUM": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,8}(?:.[0-9]{0,2})?$",
      "description": ""
    },
    "UpdateHourMeter": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "Notes": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "HaulBased": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "MonthlyRevCodeYN": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "EMGroup",
    "RevCode",
    "Basis",
    "HrsPerTimeUM",
    "UpdateHourMeter",
    "HaulBased",
    "KeyID",
    "MonthlyRevCodeYN"
  ]
}