{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com//v/object/status_codes/cache.json",
  "type": "object",
  "properties": {
    "Status": {
      "type": "string",
      "maxLength": 6,
      "description": ""
    },
    "Description": {
      "type": "string",
      "maxLength": 30,
      "description": ""
    },
    "CodeType": {
      "type": "string",
      "maxLength": 1,
      "description": ""
    },
    "IncludeInProj": {
      "type": "string",
      "maxLength": 1,
      "description": ""
    },
    "Notes": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "ExcludeYN": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "ActiveAllYN": {
      "type": "string",
      "maxLength": 1,
      "description": ""
    },
    "DocCat": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10,
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "Status",
    "Description",
    "CodeType",
    "IncludeInProj",
    "KeyID",
    "ExcludeYN",
    "ActiveAllYN"
  ]
}