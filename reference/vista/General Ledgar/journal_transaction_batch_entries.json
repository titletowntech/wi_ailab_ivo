{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com/gl/v2/object/trans_batch_entires/cache.json",
  "type": "object",
  "properties": {
    "Co": {
      "type": "integer",
      "description": ""
    },
    "Mth": {
      "type": "string",
      "description": ""
    },
    "BatchId": {
      "type": "integer",
      "description": ""
    },
    "BatchSeq": {
      "type": "integer",
      "description": ""
    },
    "BatchTransType": {
      "type": "string",
      "maxLength": 1,
      "description": ""
    },
    "GLTrans": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "GLAcct": {
      "type": "string",
      "maxLength": 20,
      "description": ""
    },
    "Jrnl": {
      "type": "string",
      "maxLength": 2,
      "description": ""
    },
    "GLRef": {
      "type": "string",
      "maxLength": 10,
      "description": ""
    },
    "Source": {
      "type": "string",
      "maxLength": 10,
      "description": ""
    },
    "ActDate": {
      "type": "string",
      "description": ""
    },
    "Description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60,
      "description": ""
    },
    "Amount": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "",
      "writeOnly": true
    },
    "OldGLAcct": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20,
      "description": ""
    },
    "OldActDate": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "OldDesc": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60,
      "description": ""
    },
    "OldAmount": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "",
      "writeOnly": true
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "InterCo": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "Co",
    "Mth",
    "BatchId",
    "BatchSeq",
    "BatchTransType",
    "GLAcct",
    "Jrnl",
    "GLRef",
    "Source",
    "ActDate",
    "Amount",
    "KeyID"
  ]
}