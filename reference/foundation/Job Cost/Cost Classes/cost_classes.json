    "company_no": {
      "type": "integer",
      "description": ""
    },
    "cost_class_no": {
      "type": "string",
      "maxLength": 5,
      "description": ""
    },
    "description": {
      "type": "string",
      "maxLength": 30,
      "description": ""
    },
    "short_desc": {
      "type": "string",
      "maxLength": 3,
      "description": ""
    },
    "allocated_overhead_perc": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,4}(?:.[0-9]{0,7})?$",
      "description": ""
    },
    "record_status": {
      "type": "string",
      "maxLength": 1,
      "description": ""
    },
    "row_modified_by": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 32,
      "description": ""
    },
    "row_modified_on": {
      "type": [
        "string",
        "null"
      ],
      "format": "datetime",
      "description": "Format: YYYY-MM-DD"
    },
    "row_unique_id": {
      "type": "integer",
      "description": ""
    },
    "income_expense": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1,
      "description": ""
    },
    "company_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10,
      "description": ""
    },
    "cost_class_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10,
      "description": ""
    },
    "Tm_Markup_Category": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2,
      "description": ""
    },
    "Tm_Include_In_Tax_Base": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1,
      "description": ""
    },
    "include_in_cost_code_budget_set": {
      "type": "string",
      "maxLength": 1,
      "description": ""
    },
    "ap_invoice_gl_expense": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[-+]?[0-9]{1,12}(?:.[0-9]{0,0})?$",
      "description": ""
    },
    "use_in_jc_ovhd_calc": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1,
      "description": ""
    },
    "tm_force_zero_price": {
      "type": "string",
      "maxLength": 1,
      "description": ""
    },
    "include_in_pct_cmpl_ws": {
      "type": "string",
      "maxLength": 1,
      "description": ""
    },
    "record_guid": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "validation_type": {
      "type": "string",
      "maxLength": 1,
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "company_no",
    "cost_class_no",
    "description",
    "short_desc",
    "allocated_overhead_perc",
    "record_status",
    "row_unique_id",
    "include_in_cost_code_budget_set",
    "tm_force_zero_price",
    "include_in_pct_cmpl_ws",
    "record_guid",
    "validation_type"
