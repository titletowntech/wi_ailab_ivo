{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://spectrum.si.ryvit.com//v/object/contract_fixed_price/cache.json",
  "type": "object",
  "properties": {
    "Company_Code": {
      "type": "string",
      "maxLength": 3,
      "description": "ENTER THE COMPANY CODE"
    },
    "Customer_Code": {
      "type": "string",
      "maxLength": 10,
      "description": "ENTER THE CUSTOMER CODE"
    },
    "Job_Number": {
      "type": "string",
      "maxLength": 10,
      "description": "ENTER THE JOB NUMBER (UP TO 10 DIGITS)"
    },
    "Description_Line_1": {
      "type": "string",
      "maxLength": 60,
      "description": "ENTER THE FIRST LINE OF CONTRACT DESCRIPTION"
    },
    "Description_Line_2": {
      "type": "string",
      "maxLength": 60,
      "description": "ENTER THE SECOND LINE OF CONTRACT DESCRIPTION"
    },
    "Description_Line_3": {
      "type": "string",
      "maxLength": 60,
      "description": "ENTER THE THIRD LINE OF CONTRACT DESCRIPTION"
    },
    "Architect": {
      "type": "string",
      "maxLength": 30,
      "description": "ENTER THE ARCHITECT FOR THIS CONTRACT"
    },
    "Original_Contract_Amount": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "ENTER THE ORIGINAL AMOUNT FOR THIS CONTRACT"
    },
    "Retention_Percent": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "ENTER THE RETENTION PERCENTAGE FOR THIS CONTRACT"
    },
    "Sales_Tax_Code": {
      "type": "string",
      "maxLength": 15,
      "description": "ENTER THE SALES TAX CODE"
    },
    "GL_Account": {
      "type": "string",
      "maxLength": 12,
      "description": "ENTER THE G/L ACCOUNT NUMBER"
    },
    "Contract_Date": {
      "type": [
        "string",
        "null"
      ],
      "description": "ENTER THE DATE OF THIS CONTRACT"
    },
    "Unit_Price_Flag": {
      "type": "string",
      "maxLength": 1,
      "description": "ENTER 'Y' IF BILLING IS BY UNIT PRICE"
    },
    "Taxable_Flag": {
      "type": "string",
      "maxLength": 1,
      "description": "IS THIS A TAXABLE CONTRACT ?  (Y OR N)"
    },
    "GL_Retention_Revenue": {
      "type": "string",
      "maxLength": 12,
      "description": "G/L RETENTION REVENUE ACCOUNT"
    },
    "Salesperson": {
      "type": "string",
      "maxLength": 3,
      "description": "ENTER THE SALESPERSON  FOR THIS CUSTOMER"
    },
    "Alternate_Address": {
      "type": "string",
      "maxLength": 1,
      "description": "SET TO 'Y' TO USE ALTERNATE BILLING ADDRESS FROM CM.BTCODE"
    },
    "Billto_Code": {
      "type": "string",
      "maxLength": 4,
      "description": "ENTER THE BILL-TO CODE"
    },
    "Cost_Center": {
      "type": "string",
      "maxLength": 10,
      "description": "CONTRACT COST CENTER"
    },
    "Dist_By_GL": {
      "type": "string",
      "maxLength": 1,
      "description": "SELECT TO DISTRIBUTE DRAW REQUEST TO INVOICE BY G/L CODE"
    },
    "Terms_Override": {
      "type": "string",
      "maxLength": 1,
      "description": "SET TO 'Y' TO OVERRIDE TERMS"
    },
    "Terms_Override_Code": {
      "type": "string",
      "maxLength": 1,
      "description": "OVERRIDE TERMS CODE"
    },
    "Status": {
      "type": "string",
      "maxLength": 1,
      "description": "CONTRACT STATUS"
    },
    "Pricing_Fee": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "PRICING FEE"
    },
    "id": {
      "type": "integer",
      "description": ""
    },
    "Customer_PO": {
      "type": "string",
      "maxLength": 25,
      "description": ""
    },
    "Line_Items": {
      "type": "array",
      "items": {
        "$id": "http://spectrum.si.ryvit.com//v/object/detals/cache.json",
        "type": "object",
        "properties": {
          "Bill_Group_Code": {
            "type": "string",
            "maxLength": 2,
            "description": "UNIT PRICE - ENTER THE BILL GROUP (2 CHARACTERS)"
          },
          "Bill_Item_Code": {
            "type": "string",
            "maxLength": 8,
            "description": "UNIT PRICE - ENTER THE BILLING ITEM CODE"
          },
          "Billing_Item_Description": {
            "type": "string",
            "maxLength": 30,
            "description": "ENTER THE BILLING ITEM DESCRIPTION"
          },
          "Taxable_Flag": {
            "type": "string",
            "maxLength": 1,
            "description": "ENTER 'Y' IF THIS ITEM IS TAXABLE, 'N' IF NOT"
          },
          "Unit_Of_Measure": {
            "type": "string",
            "maxLength": 3,
            "description": "ENTER THE UNIT OF MEASURE FOR THIS BILLING ITEM"
          },
          "Unit_Price": {
            "type": "string",
            "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,10})?$",
            "description": "ENTER THE UNIT PRICE FOR THIS BILLING ITEM"
          },
          "Contract_Quantity": {
            "type": "string",
            "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,10})?$",
            "description": "ENTER THE CONTRACT QUANTITY FOR THIS BILLING ITEM"
          },
          "Contract_Amount": {
            "type": "string",
            "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
            "description": "ENTER THE CONTRACT AMOUNT FOR THIS BILLING ITEM"
          },
          "Projected_Quantity": {
            "type": "string",
            "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,10})?$",
            "description": ""
          },
          "Projected_Amount": {
            "type": "string",
            "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
            "description": ""
          },
          "Job_To_Date_Quantity": {
            "type": "string",
            "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,10})?$",
            "description": ""
          },
          "Job_To_Date_Billed": {
            "type": "string",
            "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
            "description": ""
          },
          "Last_CO_Number": {
            "type": "string",
            "maxLength": 8,
            "description": ""
          },
          "Memo": {
            "type": "string",
            "maxLength": 25,
            "description": ""
          },
          "Unit_Price_Display_Mask": {
            "type": "string",
            "maxLength": 18,
            "description": ""
          },
          "Quantity_Display_Mask": {
            "type": "string",
            "maxLength": 16,
            "description": ""
          },
          "Description_2": {
            "type": "string",
            "maxLength": 40,
            "description": ""
          },
          "GL_Sales_Account": {
            "type": "string",
            "maxLength": 12,
            "description": ""
          },
          "Last_CR_Number": {
            "type": "string",
            "maxLength": 8,
            "description": ""
          },
          "Cost_Center": {
            "type": "string",
            "maxLength": 10,
            "description": ""
          },
          "Online_Tax_Code": {
            "type": "string",
            "maxLength": 15,
            "description": ""
          },
          "__custom_fields": {
            "type": "object",
            "description": "This property will be added if there are any custom fields defined for this object in Spectrum.  Each custom field will be a property of this object."
          }
        }
      }
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Spectrum.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "Company_Code",
    "Customer_Code",
    "Job_Number"
  ]
}