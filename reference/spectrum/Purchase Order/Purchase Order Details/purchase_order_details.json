{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://spectrum.si.ryvit.com//v/object/po_details/cache.json",
  "type": "object",
  "properties": {
    "Company_Code": {
      "type": "string",
      "maxLength": 3,
      "description": "(SYSTEM) COMPANY/DIVISION CODE ASSIGNED TO CALLING TERMINAL"
    },
    "PO_Number": {
      "type": "string",
      "maxLength": 10,
      "description": "ENTER THE PURCHASE ORDER NUMBER"
    },
    "Line_Number": {
      "type": "string",
      "maxLength": 3,
      "description": "PURCHASE ORDER DETAIL LINE NUMBER (3 CHARS)"
    },
    "PO_Quantity_Ordered": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "PO QTY (1) ORDERED (2) RECEIVED (3) DUE (4) CURR. RECEIVING (5) B/O"
    },
    "PO_Quantity_Received": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "PO QTY (1) ORDERED (2) RECEIVED (3) DUE (4) CURR. RECEIVING (5) B/O"
    },
    "PO_Quantity_Due": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "PO QTY (1) ORDERED (2) RECEIVED (3) DUE (4) CURR. RECEIVING (5) B/O"
    },
    "PO_Quantity_Current_Received": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "PO QTY (1) ORDERED (2) RECEIVED (3) DUE (4) CURR. RECEIVING (5) B/O"
    },
    "PO_Quantity_Back_Ordered": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "PO QTY (1) ORDERED (2) RECEIVED (3) DUE (4) CURR. RECEIVING (5) B/O"
    },
    "Item_Code": {
      "type": "string",
      "maxLength": 15,
      "description": "ITEM CODE"
    },
    "Item_Description": {
      "type": "string",
      "maxLength": 35,
      "description": "ITEM DESCRIPTION"
    },
    "Unit_Of_Measure": {
      "type": "string",
      "maxLength": 3,
      "description": "ENTER THE UNIT OF MEASURE"
    },
    "Item_Price": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,8}(?:.[0-9]{0,4})?$",
      "description": "ENTER THE ITEM PRICE"
    },
    "Item_Discount_Percent": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,8}(?:.[0-9]{0,4})?$",
      "description": "ENTER THE ITEM DISCOUNT %"
    },
    "Tax_Percent": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,8}(?:.[0-9]{0,4})?$",
      "description": "ENTER THE LINE TAX %"
    },
    "Tax_Amount_Ordered_Quantity": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "ENTER THE LINE TAX AMOUNT (1) ORDERED QTY (2) CURRENT RECEIVING QTY"
    },
    "Tax_Amount_Current_Received_Quantity": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "ENTER THE LINE TAX AMOUNT (1) ORDERED QTY (2) CURRENT RECEIVING QTY"
    },
    "Line_Extension_Ordered_Quantity": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "ENTER THE LINE EXTENSION (1) ORDERED QTY (2) CURRENT RECEIVING QTY"
    },
    "Line_Extension_Current_Received_Quantity": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "ENTER THE LINE EXTENSION (1) ORDERED QTY (2) CURRENT RECEIVING QTY"
    },
    "Delivery_Date": {
      "type": [
        "string",
        "null"
      ],
      "description": "ENTER THE DELIVERY DATE"
    },
    "GL_Account": {
      "type": "string",
      "maxLength": 12,
      "description": "ENTER THE GL CODE FOR THIS LINE ITEM"
    },
    "Job_Number": {
      "type": "string",
      "maxLength": 10,
      "description": "ENTER THE JOB NUMBER FOR THIS LINE ITEM"
    },
    "Phase_Code": {
      "type": "string",
      "maxLength": 20,
      "description": "ENTER THE PHASE NUMBER FOR THIS LINE ITEM"
    },
    "Cost_Type": {
      "type": "string",
      "maxLength": 3,
      "description": "ENTER THE COST TYPE FOR THIS LINE ITEM"
    },
    "Message": {
      "type": "string",
      "maxLength": 250,
      "description": "ENTER THE MESSAGE FOR THIS LINE"
    },
    "Received_Extension": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "ENTER THE RECEIVED EXTENSION FOR THIS LINE"
    },
    "Warehouse_Code": {
      "type": "string",
      "maxLength": 10,
      "description": "ENTER THIS LINE ITEM'S WAREHOUSE"
    },
    "WO_Number": {
      "type": "string",
      "maxLength": 10,
      "description": "ENTER THE WORK ORDER NUMBER FOR THIS LINE ITEM"
    },
    "Sequence": {
      "type": "string",
      "maxLength": 14,
      "description": "SEQUENCE NUMBER"
    },
    "Price_Per_Factor": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,8}(?:.[0-9]{0,4})?$",
      "description": "ENTER THIS PO ITEM'S PRICE PER FACTOR"
    },
    "Equipment_Code": {
      "type": "string",
      "maxLength": 10,
      "description": "ENTER THE EQUIPMENT CODE"
    },
    "Equipment_Category": {
      "type": "string",
      "maxLength": 4,
      "description": "ENTER THE EQUIPMENT COST CATEGORY"
    },
    "Open_Receipt_Quantity": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "ENTER THE TOTAL QTY OF ALL OPEN RECEIPTS"
    },
    "Use_Tax_Code": {
      "type": "string",
      "maxLength": 15,
      "description": "ENTER THE USE TAX CODE FOR THIS PO LINE"
    },
    "Use_Tax_Extension": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "USE TAX EXTENSION AMOUNT FOR THIS PO LINE (CALCULATED)"
    },
    "PM_Work_Order": {
      "type": "string",
      "maxLength": 10,
      "description": "PREVENTIVE MAINTENANCE WORK ORDER NUMBER"
    },
    "Terms_Discount_Percent": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "ENTER THE TERMS DISCOUNT PERCENT"
    },
    "Tax_Code": {
      "type": "string",
      "maxLength": 15,
      "description": "ENTER THE USE TAX CODE FOR THIS LINE, IF ANY"
    },
    "Taxable_Flag": {
      "type": "string",
      "maxLength": 1,
      "description": "IS THIS DETAIL LINE TAXABLE?  (Y OR N)"
    },
    "WO_Flag": {
      "type": "string",
      "maxLength": 1,
      "description": "ENTER 'W' IF LINE IS UPDATED TO WORK ORDER MATERIAL DETAIL"
    },
    "Component_Number": {
      "type": "string",
      "maxLength": 2,
      "description": "ENTER THE COMPONENT NUMBER OR WINDOW"
    },
    "System_ID": {
      "type": "string",
      "maxLength": 8,
      "description": "ENTER THE SYSTEM ID"
    },
    "WO_Item_Price": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "ENTER THE WORK ORDER MATERIAL ITEM PRICE"
    },
    "Blanket_Release_Number": {
      "type": "string",
      "maxLength": 3,
      "description": "SYSTEM-MAINTAINED BLANKET RELEASE NUMBER"
    },
    "Cost_Center": {
      "type": "string",
      "maxLength": 10,
      "description": "COST CENTER"
    },
    "SC_Contract": {
      "type": "string",
      "maxLength": 10,
      "description": "SERVICE CONTRACT"
    },
    "Control_Code": {
      "type": "string",
      "maxLength": 36,
      "description": "CONTROL CODE"
    },
    "Billing_Flag": {
      "type": "string",
      "maxLength": 1,
      "description": "BILLING FLAG"
    },
    "Line_Type": {
      "type": "string",
      "maxLength": 1,
      "description": "Line type: 'D'etail or 'M'essage."
    }
  },
  "required": [
    "Company_Code",
    "PO_Number",
    "Line_Number"
  ]
}