{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://Sage100.SI.ryvit.com/sipart/version/object/pay_groups/cache.json",
  "type": "object",
  "properties": {
    "idnum": {
      "type": "string",
      "description": "",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}"
    },
    "paygroup_id": {
      "type": "integer",
      "description": "The paygroup number",
      "minimum": 1,
      "maximum": 999999
    },
    "name": {
      "type": "string",
      "description": "Enter a description of the paygroup",
      "maxLength": 50
    },
    "classification": {
      "type": "string",
      "description": "The work classification",
      "maxLength": 50
    },
    "class_level": {
      "type": "integer",
      "description": "For certified payroll, The Class Level (1 - Trainee, 2- Apprentice, 3 - Journey Worker)",
      "minimum": 0,
      "maximum": 3
    },
    "class_percent": {
      "type": "string",
      "description": "For certified payroll, The apprenticeship class percent",
      "pattern": "^[-+]?[0-9]{1,4}(?:.[0-9]{1,2})?$",
      "minimum": 0,
      "maximum": 100
    },
    "work_classification_code": {
      "type": "string",
      "description": "For certified payroll, The Work Classification Code",
      "maxLength": 10
    },
    "override": {
      "type": "string",
      "description": "Enter Y (Yes) if the paygroup is to override employee's calculation rates",
      "maxLength": 1
    },
    "rate1": {
      "type": "string",
      "description": "The regular hourly pay rate",
      "pattern": "^[-+]?[0-9]{1,6}(?:.[0-9]{1,4})?$",
      "minimum": 0,
      "maximum": 99999
    },
    "rate2": {
      "type": "string",
      "description": "The overtime hourly pay rate",
      "pattern": "^[-+]?[0-9]{1,6}(?:.[0-9]{1,4})?$",
      "minimum": 0,
      "maximum": 99999
    },
    "rate3": {
      "type": "string",
      "description": "The premium hourly pay rate",
      "pattern": "^[-+]?[0-9]{1,6}(?:.[0-9]{1,4})?$",
      "minimum": 0,
      "maximum": 99999
    },
    "piece_rate": {
      "type": "string",
      "description": "The piece rate for the work performed",
      "pattern": "^[-+]?[0-9]{1,6}(?:.[0-9]{1,4})?$",
      "minimum": 0,
      "maximum": 99999
    },
    "union": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The union number",
      "minimum": 0,
      "maximum": 99999999
    },
    "notes": {
      "type": "string",
      "description": "Enter notes for this row"
    },
    "insdte": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "insusr": {
      "type": [
        "string",
        "null"
      ],
      "description": "",
      "maxLength": 128
    },
    "upddte": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "updusr": {
      "type": [
        "string",
        "null"
      ],
      "description": "",
      "maxLength": 128
    },
    "inactive": {
      "type": "string",
      "description": "Enter Y (Yes) for inactive or N (No) or blank for active",
      "maxLength": 1
    }
  },
  "required": [
    "idnum",
    "paygroup_id",
    "name",
    "classification",
    "class_level",
    "class_percent",
    "work_classification_code",
    "override",
    "rate1",
    "rate2",
    "rate3",
    "piece_rate",
    "notes",
    "inactive"
  ]
}