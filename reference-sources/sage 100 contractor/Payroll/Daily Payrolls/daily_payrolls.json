{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://Sage100.SI.ryvit.com/sipart/version/object/DailyPayrolls/cache.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "idnum": {
      "type": "string",
      "description": "",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}"
    },
    "date": {
      "type": "string",
      "description": "The date when the work was performed (mm/dd/yyyy)"
    },
    "line_num": {
      "type": "integer",
      "description": "",
      "minimum": 1000,
      "maximum": 30000000
    },
    "employee": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The employee number",
      "minimum": 0,
      "maximum": 9999999999
    },
    "description": {
      "type": "string",
      "description": "Enter a description of the work",
      "maxLength": 50
    },
    "service_order_num": {
      "type": "string",
      "description": "The work order number (service only)",
      "maxLength": 20
    },
    "job": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Enter a job number",
      "minimum": 0,
      "maximum": 9999999999
    },
    "equipment_repaired": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The equipment number for repair/maintenance",
      "minimum": 0,
      "maximum": 9999999999
    },
    "locality": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The local payroll-tax district number",
      "minimum": 0,
      "maximum": 999999
    },
    "certified": {
      "type": "string",
      "description": "Enter Y (Yes) for certified payroll or N (No) for non-certified payroll",
      "maxLength": 1
    },
    "phase": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Enter a phase number",
      "minimum": 0,
      "maximum": 9999999999
    },
    "cost_code": {
      "type": [
        "string",
        "null"
      ],
      "description": "Enter a cost code",
      "pattern": "^[-+]?[0-9]{1,12}(?:.[0-9]{1,3})?$",
      "minimum": 0,
      "maximum": 99999999999
    },
    "pay_type": {
      "type": "integer",
      "description": "1-Reg, 2-Ovt, 3-Prm, 4-Sick, 5-Vac, 6-Hol, 7-Piece, 8-Per Diem, 9-Misc",
      "minimum": 0,
      "maximum": 9
    },
    "paygroup": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The paygroup number",
      "minimum": 0,
      "maximum": 999999
    },
    "pay_rate": {
      "type": "string",
      "description": "The hourly rate of pay",
      "pattern": "^[-+]?[0-9]{1,6}(?:.[0-9]{1,4})?$",
      "minimum": 0,
      "maximum": 99999
    },
    "hours": {
      "type": "string",
      "description": "The number of hours worked",
      "pattern": "^[-+]?[0-9]{1,5}(?:.[0-9]{1,2})?$",
      "minimum": -999,
      "maximum": 9999
    },
    "piece_rate": {
      "type": "string",
      "description": "The piece rate for the work performed",
      "pattern": "^[-+]?[0-9]{1,6}(?:.[0-9]{1,4})?$",
      "minimum": 0,
      "maximum": 99999
    },
    "pieces": {
      "type": "string",
      "description": "The number of pieces completed",
      "pattern": "^[-+]?[0-9]{1,8}(?:.[0-9]{1,2})?$",
      "minimum": -999999,
      "maximum": 9999999
    },
    "comp_code": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The workers' compensation code",
      "minimum": 0,
      "maximum": 999999
    },
    "department": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The department number",
      "minimum": 0,
      "maximum": 9999999999
    },
    "operated_equipment": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The equipment number for operated equipment",
      "minimum": 0,
      "maximum": 9999999999
    },
    "cost_unit": {
      "type": "integer",
      "description": "1-Hours, 2-Days, 3-Weeks, 4-Months, 5-Miles",
      "minimum": 0,
      "maximum": 5
    },
    "operated": {
      "type": "string",
      "description": "The time/miles the equipment was operated",
      "pattern": "^[-+]?[0-9]{1,5}(?:.[0-9]{1,2})?$",
      "minimum": -999,
      "maximum": 9999
    },
    "standby": {
      "type": "string",
      "description": "The number units of standby time",
      "pattern": "^[-+]?[0-9]{1,5}(?:.[0-9]{1,2})?$",
      "minimum": -999,
      "maximum": 9999
    },
    "idle": {
      "type": "string",
      "description": "The number units of idle time",
      "pattern": "^[-+]?[0-9]{1,5}(?:.[0-9]{1,2})?$",
      "minimum": -999,
      "maximum": 9999
    },
    "rental_unit": {
      "type": "integer",
      "description": "1-Hours, 2-Days, 3-Weeks, 4-Months, 5-Miles, 6-Mobilization, 7-Not Billable",
      "minimum": 0,
      "maximum": 7
    },
    "operated_rental": {
      "type": "string",
      "description": "The number of units operated (time/miles) for T&M billing",
      "pattern": "^[-+]?[0-9]{1,6}(?:.[0-9]{1,2})?$",
      "minimum": -9999,
      "maximum": 99999
    },
    "standby_rental": {
      "type": "string",
      "description": "The number of units on standby for T&M billing",
      "pattern": "^[-+]?[0-9]{1,6}(?:.[0-9]{1,2})?$",
      "minimum": -9999,
      "maximum": 99999
    },
    "idle_rental": {
      "type": "string",
      "description": "The number of units of idle time for T&M billing",
      "pattern": "^[-+]?[0-9]{1,6}(?:.[0-9]{1,2})?$",
      "minimum": -9999,
      "maximum": 99999
    },
    "user_defined": {
      "type": "string",
      "description": "User defined",
      "maxLength": 50
    },
    "notes": {
      "type": "string",
      "description": "Enter notes for this row"
    },
    "absence": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Enter an absence number for the type of absence",
      "minimum": 0,
      "maximum": 999
    },
    "line_id_number": {
      "type": "string",
      "description": "",
      "maxLength": 32
    },
    "insdte": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "insusr": {
      "type": [
        "string",
        "null"
      ],
      "description": "",
      "maxLength": 128
    },
    "upddte": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "updusr": {
      "type": [
        "string",
        "null"
      ],
      "description": "",
      "maxLength": 128
    }
  }
}