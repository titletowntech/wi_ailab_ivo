{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com//v/object/EquipmentDepreciation/cache.json",
  "type": "object",
  "properties": {
    "EMCo": {
      "type": "integer",
      "description": "Equipment Management Company."
    },
    "Equipment": {
      "type": "string",
      "maxLength": 10,
      "description": "Equipment ID."
    },
    "Asset": {
      "type": "string",
      "maxLength": 20,
      "description": "Asset ID."
    },
    "Description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60,
      "description": "Asset Description."
    },
    "DeprMethod": {
      "type": "string",
      "maxLength": 1,
      "description": "Depreciation Method."
    },
    "DBFactor": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[-+]?[0-9]{1,2}(?:.[0-9]{0,6})?$",
      "description": "Double-Declining Balance Factor."
    },
    "FirstMonth": {
      "type": [
        "string",
        "null"
      ],
      "description": "Month depreciation started. Format: YYYY-MM-01."
    },
    "NoMonthsToDepr": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Number of Months to Depreciate."
    },
    "TtlToDepr": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "Total amount to be depreciated."
    },
    "MonthDisposed": {
      "type": [
        "string",
        "null"
      ],
      "description": "Month asset was disposed. Format: YYYY-MM-01."
    },
    "PurchasePrice": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "Original purchase price."
    },
    "ResidualValue": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "Asset's residual or salvage value."
    },
    "SalePrice": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "Sale price of the asset if disposed."
    },
    "AccumDeprAcct": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20,
      "description": "Accumulated Depreciation Account."
    },
    "DeprExpAcct": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20,
      "description": "Depreciation Expense Account."
    },
    "DeprAssetAcct": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20,
      "description": "Depreciable Asset Account."
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": "Unique Identifier for attachments."
    },
    "GLCo": {
      "type": "integer",
      "description": "General Ledger Company."
    },
    "Notes": {
      "type": [
        "string",
        "null"
      ],
      "description": "Asset notes."
    },
    "UseResidualVal": {
      "type": "string",
      "maxLength": 1,
      "description": "Flag to indicate if residual value is used."
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "DeprStartDate": {
      "type": [
        "string",
        "null"
      ],
      "description": "Date Depreciation Started. Format: YYYY-MM-DD"
    },
    "DateDisposed": {
      "type": [
        "string",
        "null"
      ],
      "description": "Date asset was disposed. Format: YYYY-MM-DD"
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista. Each custom field will be a property of this object."
    }
  },
  "required": [
    "EMCo",
    "Equipment",
    "Asset",
    "DeprMethod",
    "TtlToDepr",
    "GLCo",
    "UseResidualVal",
    "KeyID"
  ]
}