{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com/jc/v2/object/metric_conversions/cache.json",
  "type": "object",
  "properties": {
    "UM": {
      "type": "string",
      "maxLength": 3,
      "description": ""
    },
    "MUM": {
      "type": "string",
      "maxLength": 3,
      "description": ""
    },
    "IMFactor": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,6})?$",
      "description": ""
    },
    "MIFactor": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,6})?$",
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "UM",
    "MUM",
    "IMFactor",
    "MIFactor",
    "KeyID"
  ]
}