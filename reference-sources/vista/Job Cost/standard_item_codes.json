{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com/jc/v2/object/std_item_codes/cache.json",
  "type": "object",
  "properties": {
    "SIRegion": {
      "type": "string",
      "maxLength": 6,
      "description": ""
    },
    "SICode": {
      "type": "string",
      "maxLength": 16,
      "description": ""
    },
    "Description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60,
      "description": ""
    },
    "UM": {
      "type": "string",
      "maxLength": 3,
      "description": ""
    },
    "MUM": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 3,
      "description": ""
    },
    "UnitPrice": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,11}(?:.[0-9]{0,5})?$",
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "SIRegion",
    "SICode",
    "UM",
    "UnitPrice",
    "KeyID"
  ]
}