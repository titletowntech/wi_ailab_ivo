{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com/cost_types/v2/object/cost_types/cache.json",
  "type": "object",
  "properties": {
    "PhaseGroup": {
      "type": "integer",
      "description": ""
    },
    "CostType": {
      "type": "integer",
      "description": ""
    },
    "Description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30,
      "description": ""
    },
    "Abbreviation": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10,
      "description": ""
    },
    "TrackHours": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Y",
        "N",
        null
      ],
      "description": ""
    },
    "LinkProgress": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "Notes": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "JBCostTypeCategory": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1,
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "PhaseGroup",
    "CostType",
    "KeyID"
  ]
}