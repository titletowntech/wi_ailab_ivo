{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com/jc/v2/object/phases/cache.json",
  "type": "object",
  "properties": {
    "PhaseGroup": {
      "type": "integer",
      "description": ""
    },
    "Phase": {
      "type": "string",
      "maxLength": 20,
      "description": ""
    },
    "Description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60,
      "description": ""
    },
    "ProjMinPct": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,2}(?:.[0-9]{0,4})?$",
      "description": ""
    },
    "Notes": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    },
    "CostTypes": {
      "type": "array",
      "description": "",
      "items": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "#/properties/CostTypes/items",
        "type": "object",
        "properties": {
          "CostType": {
            "type": "integer",
            "description": "natural key for this array (CostType)"
          },
          "BillFlag": {
            "type": "string",
            "maxLength": 1,
            "description": ""
          },
          "UM": {
            "type": "string",
            "maxLength": 3,
            "description": ""
          },
          "ItemUnitFlag": {
            "type": "string",
            "enum": [
              "Y",
              "N"
            ],
            "description": ""
          },
          "PhaseUnitFlag": {
            "type": "string",
            "enum": [
              "Y",
              "N"
            ],
            "description": ""
          },
          "__custom_fields": {
            "type": "object",
            "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
          }
        },
        "required": [
          "CostType",
          "BillFlag",
          "UM",
          "ItemUnitFlag",
          "PhaseUnitFlag"
        ]
      }
    }
  },
  "required": [
    "PhaseGroup",
    "Phase",
    "ProjMinPct",
    "KeyID"
  ]
}