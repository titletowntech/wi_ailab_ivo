{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com/pr/v2/object/insurance_codes/cache.json",
  "type": "object",
  "properties": {
    "PRCo": {
      "type": "integer",
      "description": ""
    },
    "State": {
      "type": "string",
      "maxLength": 4,
      "description": ""
    },
    "InsCode": {
      "type": "string",
      "maxLength": 10,
      "description": ""
    },
    "Description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30,
      "description": ""
    },
    "ApplyLimit": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": "",
      "writeOnly": true
    },
    "EarnLimit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{1,2})?$",
      "description": "",
      "writeOnly": true
    },
    "UseThreshold": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "ThresholdRate": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,11}(?:.[0-9]{1,5})?$",
      "description": ""
    },
    "OverrideInsCode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10,
      "description": ""
    },
    "Notes": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    },
    "DednLiabs": {
      "description": "",
      "type": "array",
      "items": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "#/properties/DednLiabs/items",
        "type": "object",
        "properties": {
          "DLCode": {
            "type": "integer",
            "description": ""
          },
          "Rate": {
            "type": "string",
            "pattern": "^[-+]?[0-9]{1,11}(?:.[0-9]{1,5})?$",
            "description": "",
            "writeOnly": true
          },
          "UniqueAttchID": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 36,
            "maxLength": 36,
            "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
            "description": ""
          },
          "KeyID": {
            "type": "integer",
            "description": ""
          },
          "__custom_fields": {
            "type": "object",
            "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
          }
        },
        "required": [
          "DLCode",
          "Rate",
          "KeyID"
        ]
      }
    }
  },
  "required": [
    "PRCo",
    "State",
    "InsCode",
    "ApplyLimit",
    "UseThreshold",
    "ThresholdRate",
    "KeyID"
  ]
}