{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com/pr/v2/object/race_codes/cache.json",
  "type": "object",
  "properties": {
    "PRCo": {
      "type": "integer"
    },
    "Race": {
      "type": "string",
      "maxLength": 2
    },
    "Description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30
    },
    "EEOCat": {
      "type": "string",
      "maxLength": 1
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}"
    },
    "KeyID": {
      "type": "integer"
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "PRCo",
    "Race",
    "EEOCat",
    "KeyID"
  ]
}