{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com/v/object/sm/2/standard_items/cache.json",
  "type": "object",
  "properties": {
    "SMStandardItemID": {
      "type": "integer",
      "description": ""
    },
    "SMCo": {
      "type": "integer",
      "description": ""
    },
    "StandardItem": {
      "type": "string",
      "maxLength": 20,
      "description": ""
    },
    "Description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60,
      "description": ""
    },
    "CostRate": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[-+]?[0-9]{1,11}(?:.[0-9]{0,5})?$",
      "description": ""
    },
    "BillableRate": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[-+]?[0-9]{1,11}(?:.[0-9]{0,5})?$",
      "description": ""
    },
    "Notes": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "MiscCostOffsetGLCo": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "SMCostType": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "MiscCostOffsetGLAcct": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20,
      "description": ""
    },
    "BillableMarkup": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[-+]?[0-9]{1,11}(?:.[0-9]{0,5})?$",
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "SMStandardItemID",
    "SMCo",
    "StandardItem"
  ]
}