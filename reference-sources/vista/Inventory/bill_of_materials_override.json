        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "http://vista.si.ryvit.com//v/object/Components/cache.json",
        "type": "object",
        "properties": {
          "CompLoc": {
            "type": "string",
            "maxLength": 10,
            "description": ""
          },
