{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com//v/object/Add-Ons/cache.json",
  "type": "object",
  "properties": {
    "SLCo": {
      "type": "integer",
      "description": ""
    },
    "Addon": {
      "type": "integer",
      "description": ""
    },
    "Description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60,
      "description": ""
    },
    "Type": {
      "type": "string",
      "maxLength": 1,
      "description": ""
    },
    "Pct": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,2}(?:.[0-9]{0,4})?$",
      "description": ""
    },
    "Amount": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": ""
    },
    "ApplyPct": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "Phase": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20,
      "description": ""
    },
    "JCCType": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "Notes": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "PhaseGroup": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "SLCo",
    "Addon",
    "Type",
    "Pct",
    "Amount",
    "ApplyPct",
    "KeyID"
  ]
}