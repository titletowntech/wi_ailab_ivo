{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com/sl/v2/object/compliances/cache.json",
  "type": "object",
  "properties": {
    "SLCo": {
      "type": "integer",
      "description": ""
    },
    "SL": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30,
      "description": ""
    },
    "CompCode": {
      "type": "string",
      "maxLength": 10,
      "description": ""
    },
    "Seq": {
      "type": "integer",
      "description": ""
    },
    "VendorGroup": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "Vendor": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "Description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60,
      "description": ""
    },
    "Verify": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "ExpDate": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "Complied": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Y",
        "N",
        null
      ],
      "description": ""
    },
    "Notes": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "ReceiveDate": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "Limit": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": ""
    },
    "PurgeYN": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "APRef": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30,
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "SLCo",
    "CompCode",
    "Seq",
    "Verify",
    "Limit",
    "PurgeYN",
    "KeyID"
  ]
}