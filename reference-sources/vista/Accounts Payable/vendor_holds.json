{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com/ap/v2/object/vendor_holds/cache.json",
  "type": "object",
  "properties": {
    "APCo": {
      "type": "integer",
      "description": ""
    },
    "VendorGroup": {
      "type": "integer",
      "description": ""
    },
    "Vendor": {
      "type": "integer",
      "description": ""
    },
    "HoldCode": {
      "type": "string",
      "maxLength": 10,
      "description": ""
    },
    "Memo": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255,
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "APCo",
    "VendorGroup",
    "Vendor",
    "HoldCode",
    "KeyID"
  ]
}