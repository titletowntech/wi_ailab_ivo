{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com/ap/v2/object/pay_types/cache.json",
  "type": "object",
  "properties": {
    "APCo": {
      "type": "integer",
      "description": ""
    },
    "PayType": {
      "type": "integer",
      "description": ""
    },
    "Description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30,
      "description": ""
    },
    "GLCo": {
      "type": "integer",
      "description": ""
    },
    "GLAcct": {
      "type": "string",
      "maxLength": 20,
      "description": ""
    },
    "Notes": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "PayCategory": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "APCo",
    "PayType",
    "GLCo",
    "GLAcct",
    "KeyID"
  ]
