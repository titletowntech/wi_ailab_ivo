{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com//v/object/issues/cache.json",
  "type": "object",
  "properties": {
    "PMCo": {
      "type": "integer",
      "description": ""
    },
    "Project": {
      "type": "string",
      "maxLength": 10,
      "description": ""
    },
    "Issue": {
      "type": "integer",
      "description": ""
    },
    "Description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60,
      "description": ""
    },
    "DateInitiated": {
      "type": "string",
      "format": "date-time",
      "description": "Format: YYYY-MM-DD"
    },
    "VendorGroup": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "FirmNumber": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "Initiator": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "MasterIssue": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "DateResolved": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Format: YYYY-MM-DD"
    },
    "Status": {
      "type": "integer",
      "description": ""
    },
    "Notes": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "Type": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10,
      "description": ""
    },
    "IssueInfo": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "Reference": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30,
      "description": ""
    },
    "CostImpactYN": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "CostImpact": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": ""
    },
    "DaysImpactYN": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "DaysImpact": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "RelatedFirm": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "RelatedFirmContact": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "ROMImpact": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": ""
    },
    "ROMImpactYN": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "DescImpact": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60,
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "PMCo",
    "Project",
    "Issue",
    "DateInitiated",
    "Status",
    "KeyID",
    "CostImpactYN",
    "DaysImpactYN",
    "ROMImpactYN"
  ]
}