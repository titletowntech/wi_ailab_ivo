{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com//v/object/ResourceTraining/cache.json",
  "type": "object",
  "properties": {
    "HRCo": {
      "type": "integer",
      "description": ""
    },
    "HRRef": {
      "type": "integer",
      "description": ""
    },
    "Seq": {
      "type": "integer",
      "description": ""
    },
    "TrainCode": {
      "type": "string",
      "maxLength": 10,
      "description": ""
    },
    "Description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30,
      "description": ""
    },
    "Institution": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30,
      "description": "",
      "writeOnly": true
    },
    "Class": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30,
      "description": "",
      "writeOnly": true
    },
    "Date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "",
      "writeOnly": true
    },
    "Status": {
      "type": "string",
      "maxLength": 1,
      "description": "",
      "writeOnly": true
    },
    "Grade": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10,
      "description": "",
      "writeOnly": true
    },
    "CEUCredits": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[-+]?[0-9]{1,2}(?:.[0-9]{0,2})?$",
      "description": ""
    },
    "Hours": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[-+]?[0-9]{1,8}(?:.[0-9]{0,2})?$",
      "description": ""
    },
    "DegreeYN": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": "",
      "writeOnly": true
    },
    "DegreeDesc": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30,
      "description": "",
      "writeOnly": true
    },
    "Cost": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "",
      "writeOnly": true
    },
    "ReimbursedYN": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": "",
      "writeOnly": true
    },
    "Instructor1099YN": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "VendorGroup": {
      "type": "integer",
      "description": ""
    },
    "Vendor": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "OSHAYN": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "MSHAYN": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "FirstAidYN": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "CPRYN": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "WorkRelatedYN": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": "",
      "writeOnly": true
    },
    "HistSeq": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "Notes": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "Type": {
      "type": "string",
      "maxLength": 1,
      "description": ""
    },
    "ClassSeq": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "CompleteDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": ""
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "HRCo",
    "HRRef",
    "Seq",
    "TrainCode",
    "Status",
    "DegreeYN",
    "Cost",
    "ReimbursedYN",
    "Instructor1099YN",
    "VendorGroup",
    "OSHAYN",
    "MSHAYN",
    "FirstAidYN",
    "CPRYN",
    "WorkRelatedYN",
    "Type",
    "KeyID"
  ]
}