{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com//v/object/HRPC/cache.json",
  "type": "object",
  "properties": {
    "HRCo": {
      "type": "integer",
      "description": ""
    },
    "PositionCode": {
      "type": "string",
      "maxLength": 10,
      "description": ""
    },
    "JobTitle": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30,
      "description": ""
    },
    "Description": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "BegSalary": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": ""
    },
    "EndSalary": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": ""
    },
    "PartTimeYN": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "PartimeHrs": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[-+]?[0-9]{1,8}(?:.[0-9]{0,2})?$",
      "description": ""
    },
    "AdYN": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "AdMode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30,
      "description": ""
    },
    "ClosingDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "datetime",
      "description": "Format: YYYY-MM-DD"
    },
    "BonusYN": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "BonusPct": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[-+]?[0-9]{1,2}(?:.[0-9]{0,4})?$",
      "description": ""
    },
    "ReportLevel": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "ReportPosition": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10,
      "description": ""
    },
    "Type": {
      "type": "string",
      "maxLength": 1,
      "description": ""
    },
    "OpenJobs": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "Contact": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30,
      "description": ""
    },
    "ContactPhone": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20,
      "description": ""
    },
    "ContactEmail": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255,
      "description": ""
    },
    "ContactFax": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20,
      "description": ""
    },
    "Notes": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "HRCo",
    "PositionCode",
    "PartTimeYN",
    "AdYN",
    "BonusYN",
    "Type",
    "KeyID"
  ]
}