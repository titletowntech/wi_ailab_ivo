{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com//v/object/resource_contacts/cache.json",
  "type": "object",
  "properties": {
    "HRCo": {
      "type": "integer",
      "description": ""
    },
    "HRRef": {
      "type": "integer",
      "description": ""
    },
    "Seq": {
      "type": "integer",
      "description": ""
    },
    "Contact": {
      "type": "string",
      "maxLength": 30,
      "description": ""
    },
    "Relationship": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30,
      "description": ""
    },
    "HomePhone": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20,
      "description": ""
    },
    "WorkPhone": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20,
      "description": ""
    },
    "Address": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 60,
      "description": ""
    },
    "City": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30,
      "description": ""
    },
    "State": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4,
      "description": ""
    },
    "Zip": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 12,
      "description": ""
    },
    "Notes": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "CellPhone": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20,
      "description": ""
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "Country": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2,
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "HRCo",
    "HRRef",
    "Seq",
    "Contact",
    "KeyID"
  ]
}