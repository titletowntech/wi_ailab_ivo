{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com/hq/v2/object/escalation_materials/cache.json",
  "type": "object",
  "properties": {
    "Country": {
      "type": "string",
      "maxLength": 2,
      "description": ""
    },
    "State": {
      "type": "string",
      "maxLength": 4,
      "description": ""
    },
    "PriceIndex": {
      "type": "string",
      "maxLength": 20,
      "description": ""
    },
    "MatlGroup": {
      "type": "integer",
      "description": ""
    },
    "FinishedMatl": {
      "type": "string",
      "maxLength": 20,
      "description": ""
    },
    "ComponentMatl": {
      "type": "string",
      "maxLength": 20,
      "description": ""
    },
    "Notes": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "Country",
    "State",
    "PriceIndex",
    "MatlGroup",
    "FinishedMatl",
    "ComponentMatl",
    "KeyID"
  ]
}