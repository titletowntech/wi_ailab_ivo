{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://vista.si.ryvit.com/hq/v2/object/tax_codes/cache.json",
  "type": "object",
  "properties": {
    "TaxGroup": {
      "type": "integer",
      "description": ""
    },
    "TaxCode": {
      "type": "string",
      "maxLength": 10,
      "description": ""
    },
    "Description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30,
      "description": ""
    },
    "MultiLevel": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "OldRate": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[-+]?[0-9]{1,2}(?:.[0-9]{1,6})?$",
      "description": ""
    },
    "NewRate": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[-+]?[0-9]{1,2}(?:.[0-9]{1,6})?$",
      "description": ""
    },
    "EffectiveDate": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "GLAcct": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20,
      "description": ""
    },
    "Phase": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20,
      "description": ""
    },
    "JCCostType": {
      "type": [
        "integer",
        "null"
      ],
      "description": ""
    },
    "Notes": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "UniqueAttchID": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 36,
      "maxLength": 36,
      "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
      "description": ""
    },
    "KeyID": {
      "type": "integer",
      "description": ""
    },
    "ValueAdd": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "GST": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "ExpenseTax": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "InclGSTinPST": {
      "type": "string",
      "enum": [
        "Y",
        "N"
      ],
      "description": ""
    },
    "RetgGLAcct": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20,
      "description": ""
    },
    "DbtGLAcct": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20,
      "description": ""
    },
    "DbtRetgGLAcct": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20,
      "description": ""
    },
    "CrdRetgGSTGLAcct": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20,
      "description": ""
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
    },
    "SingleLevelMembers": {
      "description": "",
      "type": "array",
      "items": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "$id": "#/properties/SingleLevelMembers/items",
        "type": "object",
        "properties": {
          "TaxLink": {
            "type": "string",
            "maxLength": 10,
            "description": ""
          },
          "UniqueAttchID": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 36,
            "maxLength": 36,
            "pattern": "[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}",
            "description": ""
          },
          "KeyID": {
            "type": "integer",
            "description": ""
          },
          "__custom_fields": {
            "type": "object",
            "description": "This property will be added if there are any custom fields defined for this object in Vista.  Each custom field will be a property of this object."
          }
        },
        "required": [
          "TaxLink",
          "KeyID"
        ]
      }
    }
  },
  "required": [
    "TaxGroup",
    "TaxCode",
    "MultiLevel",
    "KeyID",
    "ValueAdd",
    "GST",
    "ExpenseTax",
    "InclGSTinPST"
  ]
}