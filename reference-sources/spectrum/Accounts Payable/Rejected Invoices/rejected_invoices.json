{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://spectrum.si.ryvit.com//v/object/RejectedInvoices/cache.json",
  "type": "object",
  "properties": {
    "Company_Code": {
      "type": "string",
      "maxLength": 3,
      "description": ""
    },
    "Vendor_Code": {
      "type": "string",
      "maxLength": 10,
      "description": ""
    },
    "Invoice_Number": {
      "type": "string",
      "maxLength": 20,
      "description": ""
    },
    "Invoice_Type_Code": {
      "type": "string",
      "maxLength": 1,
      "description": ""
    },
    "Invoice_Date": {
      "type": [
        "string",
        "null"
      ],
      "description": ""
    },
    "Invoice_Amount": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": ""
    },
    "Invoice_Memo": {
      "type": "string",
      "maxLength": 250,
      "description": ""
    }
  },
  "required": [
    "Company_Code",
    "Vendor_Code",
    "Invoice_Number",
    "Invoice_Type_Code"
  ]
}