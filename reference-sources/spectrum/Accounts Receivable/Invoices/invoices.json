            "type": "string",
            "maxLength": 40,
            "description": "DESCRIPTION (TECH NAME, ITEM DESC, OTHER DESC, FLAT DESC)"
          },
          "Unit_Price": {
            "type": "string",
            "pattern": "^[-+]?[0-9]{1,9}(?:.[0-9]{0,3})?$",
            "description": "ENTER THE UNIT PRICE FOR THIS LINE ITEM"
          },
