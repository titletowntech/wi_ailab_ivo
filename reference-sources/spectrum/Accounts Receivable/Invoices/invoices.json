          },
          "Cost_Of_Sale": {
            "type": "string",
            "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
            "description": "ENTER THE COST OF SALE FIELD FOR THIS LINE ITEM (NON JOB INVOICES ONLY)"
          },
