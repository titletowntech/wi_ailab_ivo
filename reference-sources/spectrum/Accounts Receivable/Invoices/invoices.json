            "type": "string",
            "maxLength": 5,
            "description": "ENTER THIS LINE ITEM'S GL DEPARTMENT CODE"
          },
          "Line_Type": {
            "type": "string",
            "maxLength": 1,
            "description": "ENTER THIS LINE'S TYPE AS POSTED FROM WORK ORDER:'L'ABOR OR 'M'ATERIAL"
          },
          "Equipment_Code": {
            "type": "string",
            "maxLength": 10,
            "description": "ENTER THE EQUIPMENT CODE"
          },
          "Rate_Type": {
            "type": "string",
            "maxLength": 1,
            "description": "ENTER THE EQUIPMENT RATE TYPE - 'H'OURLY, 'D'AILY, 'W'EEKLY, 'M'ONTHLY"
          },
          "Plant_ID": {
            "type": "string",
