{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://spectrum.si.ryvit.com//v/object/EquipmentStatus/cache.json",
  "type": "object",
  "properties": {
    "Company_Code": {
      "type": "string",
      "maxLength": 3,
      "description": "ENTER THE COMPANY CODE"
    },
    "Equipment_Status": {
      "type": "string",
      "maxLength": 4,
      "description": "ENTER THE EQUIPMENT STATUS"
    },
    "Status_Description": {
      "type": "string",
      "maxLength": 30,
      "description": "ENTER THE STATUS DESCRIPTION"
    },
    "Status_Type": {
      "type": "string",
      "maxLength": 1,
      "description": "ENTER THE EQUIPMENT STATUS TYPE ('A'CTIVE, 'I'NACTIVE,'R'ETIRED)"
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Spectrum.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "Company_Code",
    "Equipment_Status",
    "Status_Description",
    "Status_Type"
  ]
}