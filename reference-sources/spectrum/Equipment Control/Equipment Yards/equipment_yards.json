{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://spectrum.si.ryvit.com//v/object/equipment_yards/cache.json",
  "type": "object",
  "properties": {
    "Company_Code": {
      "type": "string",
      "maxLength": 3,
      "description": ""
    },
    "Yard_Code": {
      "type": "string",
      "maxLength": 5,
      "description": ""
    },
    "Yard_Description": {
      "type": "string",
      "maxLength": 30,
      "description": ""
    },
    "Latitude": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,6}(?:.[0-9]{0,6})?$"
    },
    "Longitude": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,6}(?:.[0-9]{0,6})?$"
    }
  },
  "required": [
    "Company_Code",
    "Yard_Code"
  ]
}