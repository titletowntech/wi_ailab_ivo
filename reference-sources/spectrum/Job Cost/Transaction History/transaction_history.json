{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://spectrum.si.ryvit.com//v/object/TransactionHistory/cache.json",
  "type": "object",
  "properties": {
    "__Aggregated_Id": {
      "type": "string"
    },
    "Company_Code": {
      "type": "string",
      "maxLength": 3,
      "description": "ENTER THE COMPANY CODE"
    },
    "Job_Number": {
      "type": "string",
      "maxLength": 10,
      "description": "ENTER THE JOB NUMBER (UP TO 10 DIGITS)"
    },
    "Phase_Code": {
      "type": "string",
      "maxLength": 20,
      "description": "ENTER THE JOB PHASE CODE (UP TO 20 NUMBERS)"
    },
    "Cost_Type": {
      "type": "string",
      "maxLength": 3,
      "description": "ENTER THE COST TYPE CODE (ONE LETTER OR NUMBER)"
    },
    "Tran_Type_Code": {
      "type": "string",
      "maxLength": 2,
      "description": "PR=PAYROLL,AP=ACCOUNTS PAYABLE,JC=JOB COST,IC=INVENTORY,EQ=EQUIPMENT"
    },
    "Tran_Date_Text": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8,
      "description": "THIS IS THE TRANSACTION DATE IN THE FORMAT YYYYMMDD FOR KEY PURPOSES"
    },
    "Reference_1": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 15,
      "description": "THIS IS THE REFERENCE NUMBER FOR THIS TRANSACTION TYPE"
    },
    "Reference_2": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20,
      "description": "SYSTEM ASSIGNED REFERENCE CODE BASED ON TRAN TYPE"
    },
    "Detail_Sequence": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10,
      "description": "SEQUENCE NUMBER IF POSTED IN DETAIL"
    },
    "Description": {
      "type": "string",
      "maxLength": 30,
      "description": "ENTER THE DESCRIPTION FOR THIS JOB COST ADJUSTMENT (UP TO 30 CHARACTERS)"
    },
    "Employee_Code": {
      "type": "string",
      "maxLength": 11,
      "description": "EMPLOYEE CODE"
    },
    "Vendor_Code": {
      "type": "string",
      "maxLength": 10,
      "description": "VENDOR CODE"
    },
    "Item_Code": {
      "type": "string",
      "maxLength": 15,
      "description": "ITEM CODE"
    },
    "Adjust_Reference": {
      "type": "string",
      "maxLength": 15,
      "description": "THE REFERENCE NUMBER FOR JOB COST ADJUSTMENTS"
    },
    "Invoice_Number": {
      "type": "string",
      "maxLength": 20,
      "description": "VENDOR ITEMS CODE (I.E. INVOICE # OR CR MEMO #)"
    },
    "Invoice_Date": {
      "type": [
        "string",
        "null"
      ],
      "description": "THE INVOICE DATE"
    },
    "Po_Number": {
      "type": "string",
      "maxLength": 15,
      "description": "ITEM PURCHASE ORDER NUMBER"
    },
    "Check_Number": {
      "type": "string",
      "maxLength": 6,
      "description": "ENTER THE CHECK NUMBER"
    },
    "Quantity": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "ENTER THE TOTAL QUANTITY ISSUED"
    },
    "Pr_Burden": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "PAYROLL BURDEN AMOUNT"
    },
    "PR_Hours1": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "PAYROLL HOURS: (1) reg, (2) ovt, (3) dbl, (4) vac, (5) hol, (6) sic"
    },
    "PR_Hours2": {
      "type": "string",
