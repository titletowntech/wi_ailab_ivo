    },
    "PR_Pay_Amount4": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "PAYROLL PAY AMTS: (1)-REG,(2)-OT,(3)-DBL,(4)-VAC,(5)-HOL,(6)-SIC,(7)-ADDON"
    },
    "PR_Pay_Amount5": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "PAYROLL PAY AMTS: (1)-REG,(2)-OT,(3)-DBL,(4)-VAC,(5)-HOL,(6)-SIC,(7)-ADDON"
    },
    "PR_Pay_Amount6": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "PAYROLL PAY AMTS: (1)-REG,(2)-OT,(3)-DBL,(4)-VAC,(5)-HOL,(6)-SIC,(7)-ADDON"
    },
    "PR_Pay_Amount7": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "PAYROLL PAY AMTS: (1)-REG,(2)-OT,(3)-DBL,(4)-VAC,(5)-HOL,(6)-SIC,(7)-ADDON"
    },
    "Pr_Company_Code": {
      "type": "string",
      "maxLength": 3,
      "description": "PAYROLL COMPANY CODE"
    },
    "Employee_Name": {
      "type": "string",
      "maxLength": 30,
      "description": "SET UP FILE ALIAS"
    },
    "AP_Company_Code": {
      "type": "string",
      "maxLength": 3,
      "description": "ACCOUNTS PAYABLE COMPANY CODE"
    },
    "Vendor_Name": {
      "type": "string",
      "maxLength": 30,
      "description": "ENTER THE VENDOR NAME"
    },
    "Equip_Company_Code": {
      "type": "string",
      "maxLength": 3,
      "description": "EQUIPMENT CONTROL COMPANY CODE"
    },
    "Batch_Code": {
      "type": "string",
      "maxLength": 10,
      "description": "BATCH CODE FOR THIS TRANSACTION"
    },
    "Batch_Sequence": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "BATCH SEQUENCE NUMBER"
    },
    "Unit_of_Measure": {
      "type": "string",
      "maxLength": 3,
      "description": "ENTER THE UNIT OF MEASURE"
    },
    "Draw_Appl_Number": {
      "type": "string",
      "maxLength": 3,
      "description": "THE APPLICATION NUMBER FOR THIS DRAW REQUEST"
    },
    "Customer_Code": {
      "type": "string",
      "maxLength": 10,
      "description": "THE CUSTOMER CODE FOR THE DRAW REQUEST"
    },
    "Inventory_Company_Code": {
      "type": "string",
      "maxLength": 3,
      "description": "INVENTORY CONTROL COMPANY CODE"
    },
    "Item_Description": {
      "type": "string",
      "maxLength": 35,
      "description": "ITEM DESCRIPTION"
    },
    "Crew_Number": {
      "type": "string",
      "maxLength": 10,
      "description": "ENTER THE CREW CODE"
    },
    "Cost_Center": {
      "type": "string",
      "maxLength": 10,
      "description": "ENTER THE COST CENTER CODE"
    },
    "Tran_Date_Text_Year": {
      "type": "string",
      "maxLength": 5,
      "description": "Transaction date text, 4 digit year"
    },
    "Tran_Date_Text_Period": {
      "type": "string",
      "maxLength": 2,
      "description": "FISCAL PERIOD FOR THIS TRANS. DATE TEXT"
    },
    "__custom_fields": {
      "type": "object",
      "description": "This property will be added if there are any custom fields defined for this object in Spectrum.  Each custom field will be a property of this object."
    }
  },
  "required": [
    "__Aggregated_Id",
    "Company_Code",
    "Job_Number",
    "Phase_Code",
    "Tran_Type_Code",
    "Tran_Date_Text"
