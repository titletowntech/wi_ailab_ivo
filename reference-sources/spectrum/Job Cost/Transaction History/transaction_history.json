      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "THIS IS THE TOTAL NUMBER OF HOURS FOR THIS TRANSACTION"
    },
    "Tran_Amount": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "THIS IS THE DOLLAR AMOUNT OF THE TRANSACTION"
    },
    "PR_Pay_Amount1": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "PAYROLL PAY AMTS: (1)-REG,(2)-OT,(3)-DBL,(4)-VAC,(5)-HOL,(6)-SIC,(7)-ADDON"
    },
    "PR_Pay_Amount2": {
      "type": "string",
      "pattern": "^[-+]?[0-9]{1,10}(?:.[0-9]{0,2})?$",
      "description": "PAYROLL PAY AMTS: (1)-REG,(2)-OT,(3)-DBL,(4)-VAC,(5)-HOL,(6)-SIC,(7)-ADDON"
    },
    "PR_Pay_Amount3": {
